{
    "name": "raspberry-ui",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve -o",
        "mock-server": "node mock-server/server.js",
        "start:ui": "ng serve --configuration mock",
        "start:mock": "concurrently --kill-others --names mock,ng \"npm run mock-server\" \"ng serve --configuration mock\"",
        "build": "ng build --configuration production",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "check:build": "node scripts/check-build.mjs",
        "test:ci": "ng test --no-watch --coverage",
        "e2e": "playwright test",
        "lint": "ng lint",
        "format": "prettier --write ."
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "21.0.0",
        "@angular/common": "21.0.0",
        "@angular/compiler": "21.0.0",
        "@angular/core": "21.0.0",
        "@angular/forms": "21.0.0",
        "@angular/platform-browser": "21.0.0",
        "@angular/platform-browser-dynamic": "21.0.0",
        "@angular/platform-server": "21.0.0",
        "@angular/router": "21.0.0",
        "@angular/ssr": "21.0.0",
        "@fontsource/roboto": "5.3.0",
        "@fortawesome/angular-fontawesome": "4.0.0",
        "@fortawesome/free-brands-svg-icons": "7.1.0",
        "@fortawesome/free-regular-svg-icons": "7.1.0",
        "@fortawesome/free-solid-svg-icons": "7.1.0",
        "rxjs": "7.8.2",
        "socket.io-client": "4.8.1",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^21.0.0",
        "@angular/cli": "21.0.0",
        "@angular/compiler-cli": "21.0.0",
        "@playwright/test": "^1.65.0",
        "@vitest/coverage-v8": "^4.0.8",
        "angular-eslint": "21.1.0",
        "concurrently": "10.0.6",
        "cors": "2.8.6",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "express": "5.3.0",
        "jsdom": "^27.4.0",
        "prettier": "3.7.4",
        "socket.io": "4.8.4",
        "typescript": "7.0.2",
        "typescript-eslint": "8.47.0",
        "vitest": "^4.0.8"
    }
}
